{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": ["model.joblib", "Breast_cancer_dataset.csv", "ml.py", "page.py"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "app.py" }]
}
